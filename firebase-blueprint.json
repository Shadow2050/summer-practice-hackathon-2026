{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "sportsInterests": { "type": "array", "items": { "type": "string" } },
        "skillLevels": { "type": "object", "additionalProperties": { "type": "string" } },
        "availabilityStatus": { "type": "string", "enum": ["available", "unavailable", "maybe"] },
        "lastActive": { "type": "string", "format": "date-time" },
        "location": { "type": "object", "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } }
      },
      "required": ["uid", "displayName"]
    },
    "Availability": {
      "title": "Availability",
      "description": "Daily/Weekly sports availability",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "isAvailable": { "type": "boolean" },
        "sports": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "isAvailable"]
    },
    "Event": {
      "title": "Event",
      "description": "A sports activity/match",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "sport": { "type": "string" },
        "time": { "type": "string", "format": "date-time" },
        "location": { "type": "object", "properties": { "name": { "type": "string" }, "lat": { "type": "number" }, "lng": { "type": "number" }, "address": { "type": "string" } } },
        "captainId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["proposed", "confirmed", "completed", "cancelled"] },
        "isAutoGenerated": { "type": "boolean" },
        "maxParticipants": { "type": "number" },
        "minParticipants": { "type": "number" },
        "priceInfo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sport", "time", "captainId", "participants", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message within an event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderId", "text", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "availabilities/{availabilityId}": {
      "schema": "Availability",
      "description": "User daily availability responses"
    },
    "events/{eventId}": {
      "schema": "Event",
      "description": "Sports events and matches"
    },
    "events/{eventId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Event-specific chat messages"
    }
  }
}
